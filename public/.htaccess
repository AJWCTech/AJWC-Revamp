# ===================================================================
# AJWC portfolio (Next.js static export) - Apache config for Fasthosts
#
# Carried forward from the previous site's .htaccess, with four changes
# for the export. All four are explained where they appear:
#   1. script-src must allow 'unsafe-inline'   (see CSP block)
#   2. www is made canonical                   (see redirect block)
#   3. the OG card needs a forced MIME type    (see MIME block)
#   4. /_next/static/ gets an immutable cache  (see caching block)
#
# If the site 500s after uploading, rename this to .htaccess-off and add
# the blocks back one at a time to find the unsupported one.
# ===================================================================

Options -Indexes

# --- Canonical host: www ---------------------------------------------
# www.ajwctechconsulting.com is canonical. Serving both it and the bare
# domain splits search ranking across two origins and makes the OG tags
# disagree with the address bar.
#
# This also forces HTTPS. Enable only once https:// is confirmed working
# on the real domain - if HTTPS is broken, this locks you out of the site.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bare domain -> www, preserving the path.
    RewriteCond %{HTTP_HOST} ^ajwctechconsulting\.com$ [NC]
    RewriteRule ^(.*)$ https://www.ajwctechconsulting.com/$1 [R=301,L]

    # http -> https.
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Security headers -------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # Content Security Policy.
    #
    # CHANGED FROM THE OLD SITE: script-src now allows 'unsafe-inline'.
    # This is a real downgrade and it is not optional on a static host.
    #
    # Next.js emits four inline <script> tags. Three have stable hashes,
    # but the fourth is a ~24 KB React hydration payload whose hash
    # changes on EVERY build, because it carries the page content. So:
    #   - a hash allow-list would need repasting into this file on every
    #     single deploy, and one missed update silently breaks the site;
    #   - nonces are the correct fix but must be generated per request by
    #     a server, and a static export has no server.
    #
    # With the old strict policy the site still LOOKS fine for a moment
    # and then does nothing: React never boots, so no 3D, no theme or
    # motion toggles, no mobile menu.
    #
    # To get the strict policy back, host on a Node runtime (Vercel or
    # similar) and issue a per-request nonce from middleware. See
    # docs/DEPLOYMENT.md.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'self'; upgrade-insecure-requests"

    Header always unset X-Powered-By
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # HSTS - ENABLED. The usual warning is "only turn this on once HTTPS
    # is confirmed working", and it has been confirmed, on 19 Aug 2026:
    #
    #   https://www.ajwctechconsulting.com   200, valid certificate
    #   https://ajwctechconsulting.com       200, valid certificate
    #   http://www.ajwctechconsulting.com    301 -> https
    #
    # max-age is deliberately 86400 (one day), not a year. A browser that
    # sees this header refuses plain http for the stated period and you
    # cannot withdraw that, so the blast radius of a mistake is capped at
    # 24 hours rather than 12 months.
    #
    # includeSubDomains is deliberately ABSENT: it would force HTTPS on
    # every subdomain too, including any that do not have a certificate.
    #
    # After the site has run for a week without HTTPS problems, replace
    # the line below with the long one to get real protection:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Strict-Transport-Security "max-age=86400"
</IfModule>

ServerSignature Off

# --- MIME fixes for the export ---------------------------------------
# Next exports the Open Graph card WITHOUT a file extension, so Apache
# serves it as application/octet-stream and some scrapers reject it.
<Files "opengraph-image">
    ForceType image/png
</Files>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
</IfModule>

# --- Block files that should never be served --------------------------
<FilesMatch "\.(bak|old|swp|tmp|log|ini|cfg|env|pyc|dist|sql~)$">
    Require all denied
</FilesMatch>

# Filename-based rule. NOTE: this tests the FILENAME only, so it does not
# protect a hidden DIRECTORY - /.git/config has the filename "config".
# The path-based rule below is the one that does that.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.well-known/ - [L]
    RewriteRule (^|/)\.(git|claude|hg|svn|bzr|idea|vscode|superpowers|agents|next)(/|$) - [F,L]
    RewriteRule (^|/)\.gitignore$ - [F,L]
</IfModule>

<IfModule mod_alias.c>
    RedirectMatch 404 (?i)(^|/)\.(git|claude|hg|svn|bzr|idea|vscode|superpowers|agents)(/|$)
</IfModule>

# Source and config files, if one ever slips through.
# .txt is deliberately NOT blocked: the export writes __next_*.txt RSC
# payloads that client-side navigation fetches, and robots.txt.
<FilesMatch "\.(md|lock|yml|yaml|toml|py|sh|ps1)$">
    Require all denied
</FilesMatch>

# --- Extensionless URLs -----------------------------------------------
# REQUIRED. The export writes work.html, cv.html and so on, but it does
# NOT write work/index.html - the work/ directory holds only the RSC
# payload files client-side navigation fetches.
#
# So clicking a link inside the site works, while a hard refresh,
# bookmark or shared link to /work would 404, and the sitemap points at
# exactly those extensionless URLs.
#
# This maps /work -> /work.html when the .html exists. Both URL shapes
# then resolve, which also keeps the old site's /privacy.html links alive.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
    RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# --- Default page and errors ------------------------------------------
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# --- Compression and caching -----------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 1 day"
    ExpiresByType text/javascript         "access plus 1 day"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType application/pdf         "access plus 1 day"
    # HTML must not be cached: it is what points at the hashed bundles
    # below, so a stale page would load a build that no longer exists.
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# Everything under /_next/static/ has a content hash in its filename, so
# it can be cached forever - a changed file gets a different name.
#
# Matched on the request PATH via SetEnvIf, not FilesMatch: FilesMatch
# tests the filename only, so a \.(js|css)$ rule would mark every script
# on the site immutable, including anything served from outside the
# hashed bundle directory.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_next/static/" AJWC_IMMUTABLE
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=AJWC_IMMUTABLE
</IfModule>
